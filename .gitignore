# Machine-local files and credentials
.DS_Store
._*
.env
.env.*
!.env.example
*.pem
*.key

# Harness settings hold a live ANTHROPIC_AUTH_TOKEN in plaintext. The whole directory is ignored
# rather than just that file, so a settings.local.json or a new credential file cannot slip in
# through `git add -A`.
.claude/

# Dependencies and caches
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.cache/
*.log
*.pid
*.blend1
*.blend2

# Local rollback archives and generated diagnostic captures
/backup/
/output/
/evidence/

# Runtime assets and authoritative production inputs are intentionally tracked.

# Reproducible web deployment output
/dist/
/.vercel/
.vercel
.env*
